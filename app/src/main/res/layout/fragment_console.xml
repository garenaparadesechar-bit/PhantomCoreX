<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CONSOLA" android:textColor="@color/phx_purple"
        android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="20dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/bg_card" android:padding="10dp">
        <TextView android:id="@+id/tv_log" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="> Sistema iniciado...\n" android:textColor="#00FF00" android:fontFamily="monospace"/>
    </ScrollView>
</LinearLayout>
