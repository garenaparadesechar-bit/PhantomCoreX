<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center">
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PHANTOM CORE X" android:textColor="@color/phx_purple"
            android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="30dp"/>

        <TextView android:id="@+id/tv_battery" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Batería: Cargando..." android:textColor="@color/phx_white"
            android:textSize="16sp" android:background="@drawable/bg_card" android:padding="15dp" android:layout_marginBottom="10dp"/>

        <TextView android:id="@+id/tv_ram" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RAM: Cargando..." android:textColor="@color/phx_white"
            android:textSize="16sp" android:background="@drawable/bg_card" android:padding="15dp" android:layout_marginBottom="30dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_turbo" android:layout_width="200dp" android:layout_height="200dp"
            android:text="TURBO\nCORE" android:textSize="20sp" android:textStyle="bold"
            app:backgroundTint="@color/phx_purple" app:cornerRadius="100dp" />
    </LinearLayout>
</ScrollView>
